<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Voice food logging (speech-to-text).
         MODIFY_AUDIO_SETTINGS is required alongside RECORD_AUDIO: Capacitor's
         BridgeWebChromeClient requests both together for an AUDIO_CAPTURE
         WebView permission request, and an undeclared permission in that batch
         denies the whole request. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Barcode scanning. ScanBarcode.tsx calls getUserMedia in the WebView,
         which routes through BridgeWebChromeClient.onPermissionRequest ->
         requestPermissions(CAMERA). Requesting a permission that is not
         declared here returns denied immediately, so the scanner fails on
         device. @capacitor/camera does not declare CAMERA itself because it
         uses system intents, so it must be declared here. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Keep the app installable on camera-less devices: declaring the CAMERA
         permission otherwise makes Play Store imply a hard camera requirement. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!--
        Android 11+ package visibility: without this the speech recognizer
        cannot be discovered and SpeechRecognition.available() returns false.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
</manifest>
