# MacroPal Environment Variables

# ============================================
# Demo Mode Configuration
# ============================================
# Set to "true" to enable demo mode
# Demo mode bypasses authentication and uses local storage
# Perfect for showcasing the app without user accounts
VITE_DEMO_MODE=false

# ============================================
# Firebase Configuration
# ============================================
# Get these values from your Firebase project settings
# Firebase Console: https://console.firebase.google.com/

# Your Firebase project API key
VITE_FIREBASE_API_KEY=your_firebase_api_key_here

# Firebase Auth Domain (e.g., your-project.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain_here

# Firebase Project ID
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id_here

# Firebase Storage Bucket (e.g., your-project.firebasestorage.app)
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here

# Firebase Messaging Sender ID
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id_here

# Firebase App ID
VITE_FIREBASE_APP_ID=your_firebase_app_id_here

# Firebase Measurement ID (for Analytics)
VITE_FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id_here

# Google Sign-In Web Client ID
# Required for Google authentication
VITE_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id_here

# ============================================
# AI Features (Optional)
# ============================================
# Google Cloud Vision API Key
# Optional: Enhances food recognition accuracy
# Free tier: 1000 requests/month
# Get your key at: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_VISION_API_KEY=your_google_vision_api_key_here

# ============================================
# Instructions
# ============================================
# 1. Copy this file to .env in the project root
# 2. Replace placeholder values with your actual keys
# 3. Never commit your .env file to version control
# 4. Rebuild the app after changing environment variables:
#    npm run build
