rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function roleOf(uid) {
      return userDoc(uid).data.role;
    }

    function isClinician(uid) {
      return roleOf(uid) in ["clinician", "admin"];
    }

    function isAdmin(uid) {
      return roleOf(uid) == "admin";
    }

    function isAssigned(clinicianUid, userUid) {
      return exists(/databases/$(database)/documents/users/$(clinicianUid)/assignedUsers/$(userUid));
    }

    function canReadUser(userUid) {
      return isSelf(userUid) || (signedIn() && isAssigned(request.auth.uid, userUid));
    }

    // `role` is what isClinician()/isAdmin() gate every privileged path on, so
    // it must never be self-assignable. Clients legitimately write role:"user"
    // (see the clinician-invite transaction in ClinicianConnect.tsx), so the
    // constraint is on the VALUE, not on touching the field: a client may leave
    // role untouched or set it to "user", never to "clinician" or "admin".
    // Elevated roles are granted out-of-band (admin console / Cloud Function).
    function roleNotEscalated() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["role"])
        || request.resource.data.role == "user";
    }

    function roleSafeOnCreate() {
      return !("role" in request.resource.data)
        || request.resource.data.role == "user";
    }

    function canSetHasEverLoggedFood(uid) {
      return signedIn()
        && isAssigned(request.auth.uid, uid)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["profile"])
        && request.resource.data.profile is map
        && resource.data.profile is map
        && request.resource.data.profile.diff(resource.data.profile).changedKeys().hasOnly(["hasEverLoggedFood"])
        && request.resource.data.profile.hasEverLoggedFood == true;
    }

    match /meta/{docId} {
      allow read: if true;
      allow write: if signedIn() && isAdmin(request.auth.uid);
    }

    match /users/{uid} {
      allow read: if canReadUser(uid);
      allow create: if isSelf(uid) && roleSafeOnCreate();
      allow update: if (isSelf(uid) && roleNotEscalated()) || canSetHasEverLoggedFood(uid);
      allow delete: if isSelf(uid);

      match /foods/{dateKey} {
        allow read, write: if isSelf(uid) || (signedIn() && isAssigned(request.auth.uid, uid));
      }

      match /workouts/{dateKey} {
        allow read, write: if isSelf(uid) || (signedIn() && isAssigned(request.auth.uid, uid));
      }

      match /weighins/{dateKey} {
        allow read, write: if isSelf(uid) || (signedIn() && isAssigned(request.auth.uid, uid));
      }

      match /water/{dateKey} {
        allow read, write: if isSelf(uid) || (signedIn() && isAssigned(request.auth.uid, uid));
      }

      match /plans/{dateKey} {
        allow read, write: if isSelf(uid) || (signedIn() && isAssigned(request.auth.uid, uid));
      }

      match /favorites/{favoriteId} {
        allow read, write: if isSelf(uid);
      }

      match /customFoods/{foodId} {
        allow read, write: if isSelf(uid);
      }

      match /recentFoods/{foodId} {
        allow read, write: if isSelf(uid);
      }

      match /mealTemplates/{templateId} {
        allow read, write: if isSelf(uid);
      }

      match /mealPresets/{presetId} {
        allow read, write: if isSelf(uid);
      }

      // {uid} is the clinician, {userUid} is the patient being assigned.
      //
      // Creation is the consent step, so it belongs to the PATIENT: only the
      // user being assigned may create the link, and only toward an account
      // that genuinely holds a clinician role. The previous rule keyed on
      // isSelf(uid) -- the clinician -- which both let any clinician silently
      // assign arbitrary patients to themselves and denied the real invite
      // redemption in ClinicianConnect.tsx, where the patient performs this
      // write. Either party may end the relationship.
      match /assignedUsers/{userUid} {
        allow read: if isSelf(uid) || isAdmin(request.auth.uid);
        allow create: if isSelf(userUid) && isClinician(uid);
        allow update: if isSelf(userUid);
        allow delete: if isSelf(userUid) || isSelf(uid);
      }

      match /carePlanTemplates/{templateId} {
        allow read, write: if isSelf(uid) && isClinician(request.auth.uid);
      }

      match /carePlans/{planId} {
        allow read: if isSelf(uid) || (signedIn() && isAssigned(request.auth.uid, uid));
        allow create: if signedIn() && isAssigned(request.auth.uid, uid);
        allow update: if isSelf(uid) || (signedIn() && isAssigned(request.auth.uid, uid));
        allow delete: if signedIn() && isAssigned(request.auth.uid, uid);
      }

      match /alerts/{alertId} {
        allow read: if isSelf(uid) || (signedIn() && isAssigned(request.auth.uid, uid));
        allow update: if signedIn() && isAssigned(request.auth.uid, uid);
      }

      match /reports/{reportId} {
        allow read: if isSelf(uid) || (signedIn() && isAssigned(request.auth.uid, uid));
      }

      match /messages/{threadId} {
        allow read: if isSelf(uid) || (signedIn() && isAssigned(request.auth.uid, uid));
        allow create, update: if isSelf(uid) || (signedIn() && isAssigned(request.auth.uid, uid));

        match /items/{messageId} {
          allow read: if isSelf(uid) || (signedIn() && isAssigned(request.auth.uid, uid));
          allow create: if isSelf(uid) || (signedIn() && isAssigned(request.auth.uid, uid));
        }
      }
    }

    match /pairingCodes/{code} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;

      // `get` stays open because redeeming requires looking up a code someone
      // was handed out-of-band. `list` is denied: a blanket read let any signed-in
      // user enumerate every pairing code and harvest the ownerUid on each,
      // which is how an attacker built a target list of user ids.
      allow get: if signedIn();
      allow list: if false;

      // Only the owner may delete. `delete: if signedIn()` let anyone destroy
      // anyone else's pairing codes. Redeemers no longer delete the code they
      // consumed -- it self-expires via the 5 minute TTL in useSharing.ts.
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /clinicianInvites/{code} {
      // Same split as pairingCodes: redeeming needs `get`, but listing exposed
      // every clinician/patient relationship to any signed-in user.
      allow get: if signedIn();
      allow list: if signedIn() && isAdmin(request.auth.uid);
      allow create, update, delete: if signedIn() && (
        request.resource.data.clinicianUid == request.auth.uid ||
        resource.data.clinicianUid == request.auth.uid ||
        isAdmin(request.auth.uid)
      );
    }

    match /auditLogs/{logId} {
      allow read: if signedIn() && isAdmin(request.auth.uid);
      allow create: if signedIn() && (isClinician(request.auth.uid) || isAdmin(request.auth.uid));
    }

    match /feedback/{feedbackId} {
      // Logged-in users can submit their own feedback doc
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.category in ["bug", "feature", "ux", "other"]
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 2000;
    
      // User can read their own feedback; admins can read all
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin(request.auth.uid));
    
      // Admin-only moderation
      allow update, delete: if request.auth != null && isAdmin(request.auth.uid);
    }

    match /foodSubmissions/{submissionId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.source == "user_custom_food";
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || isAdmin(request.auth.uid));
      allow update, delete: if signedIn() && isAdmin(request.auth.uid);
    }
  }
}
