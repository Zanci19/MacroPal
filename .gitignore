# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
/logs
/cypress/screenshots
/cypress/videos

# production
/dist

# NOTE: android/ is intentionally NOT ignored. The native project holds
# hand-maintained config (AndroidManifest permissions, the speech-recognizer
# <queries> block) that is silently lost on a fresh clone or `cap add android`
# if it is untracked. Build output and local.properties are excluded by
# android/.gitignore.

# misc
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
/.nx
/.nx/cache
/.vscode/*
!/.vscode/extensions.json
.idea
/public/assets/demo-loop.mp4
/scripts/data

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Optional eslint cache
.eslintcache
.env.local

# Compiled TypeScript config files
capacitor.config.js
