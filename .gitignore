# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
/logs
/cypress/screenshots
/cypress/videos

# production
/dist

# NOTE: android/ is intentionally NOT ignored. The native project holds
# hand-maintained config (AndroidManifest permissions, the speech-recognizer
# <queries> block) that is silently lost on a fresh clone or `cap add android`
# if it is untracked. Build output and local.properties are excluded by
# android/.gitignore.

# misc
.DS_Store
.env
# .env.txt held real credentials while only `.env` was ignored; match any
# variant so a renamed copy cannot slip past this rule again.
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local
/.nx
/.nx/cache
/.vscode/*
!/.vscode/extensions.json
.idea
/public/assets/demo-loop.mp4
/scripts/data

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Signing keys. Anyone holding the release key can sign an APK that Android
# accepts as an authentic update to this app -- never commit these.
*.keystore
*.jks

# Optional eslint cache
.eslintcache
.env.local

# Compiled TypeScript config files
capacitor.config.js

# Firestore emulator debug output
firestore-debug.log
firebase-debug.log
ui-debug.log
